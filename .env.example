# ==========================================
# Minecraft Server
# ==========================================

HOST=play.example.net
PORT=25565

# Minecraft username
USERNAME=AFK_Bot

# Minecraft version
# Example: 1.21.11
# Use null for automatic detection
VERSION=null


# ==========================================
# Microsoft Authentication
# ==========================================
# Leave these blank for offline/cracked servers.
#
# For Microsoft accounts, Mineflayer may require
# an interactive/device authentication flow.

AUTH_EMAIL=
AUTH_PASSWORD=


# ==========================================
# Anti-AFK
# ==========================================

# Time between anti-AFK actions in milliseconds
# 25000 = 25 seconds

ANTI_AFK_INTERVAL=25000


# ==========================================
# Remote Control API
# ==========================================

# HTTP API port
API_PORT=3000

# Use a long random secret
API_SECRET=change-this-to-a-long-random-secret
